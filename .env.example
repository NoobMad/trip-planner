# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional — defaults to gemini-3.5-flash (falls back to gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.5-flash

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session signing secret — use a long random string
SESSION_SECRET=change-me-to-a-long-random-string

# Server
PORT=3000
BASE_URL=http://localhost:3000

# Database — leave empty locally to use the bundled SQLite file.
# On Vercel this is injected by the Neon integration.
DATABASE_URL=
